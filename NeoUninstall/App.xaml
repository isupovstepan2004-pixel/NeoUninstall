<Application x:Class="NeoUninstall.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NeoUninstall.ViewModels"
             xmlns:views="clr-namespace:NeoUninstall.Views"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Theme.xaml"/></ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="B2V"/>
      <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:SoftwareViewModel}"><views:SoftwareView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:LeftoversViewModel}"><views:LeftoversView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:TasksViewModel}"><views:TasksView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:ServicesViewModel}"><views:ServicesView/></DataTemplate>
      <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
