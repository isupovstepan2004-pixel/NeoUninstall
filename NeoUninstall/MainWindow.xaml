<Window x:Class="NeoUninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeoUninstall" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Margin="6,8,6,24">
          <TextBlock Text="NeoUninstall" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
          <TextBlock Text="Cleanup &amp; audit" Style="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Current, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" CornerRadius="8" Padding="12,10" Margin="0,2" Background="Transparent">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" Foreground="{StaticResource CyanBrush}"/>
                        <TextBlock Text="{Binding Title}" FontSize="14"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20242E"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#2A3040"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="28"/>
  </Grid>
</Window>
