<UserControl x:Class="NeoUninstall.Views.LeftoversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Run as administrator" Command="{Binding RestartAdminCommand}" Visibility="{Binding NeedsAdmin, Converter={StaticResource B2V}}" Margin="0,0,10,0"/>
        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
        <Button Content="Scan for leftovers" Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Leftovers" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,12" Foreground="{StaticResource CyanBrush}"
                 Background="{StaticResource Surface2Brush}" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Select High confidence" Command="{Binding SelectHighCommand}" Margin="0,0,10,0"/>
          <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Margin="0,0,10,0"/>
          <Button Content="{Binding DeleteLabel}" Command="{Binding CleanCommand}" Style="{StaticResource AccentButton}"/>
        </StackPanel>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Why this item was reported" Style="{StaticResource Muted}" FontSize="11"/>
          <TextBlock Text="{Binding SelectedItem.Evidence, FallbackValue='Select an item to see the evidence.'}" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource ListItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding TopConfidence}" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DataGrid Grid.Column="2" ItemsSource="{Binding SelectedGroup.Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" GridLinesVisibility="None"
                HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="40">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="80"/>
          <DataGridTemplateColumn Header="Confidence" Width="95" SortMemberPath="Confidence">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
              <TextBlock Text="{Binding ConfidenceText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ConfidenceText}" Value="High"><Setter Property="Foreground" Value="{StaticResource CyanBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding ConfidenceText}" Value="Medium"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding ConfidenceText}" Value="Low"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" SortMemberPath="SizeBytes"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
