<UserControl x:Class="NeoUninstall.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Software" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Count}" Style="{StaticResource Muted}"/>
    </StackPanel>
    <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,10,0"/>
          <Button Content="Deep uninstall…" Command="{Binding DeepUninstallCommand}" Margin="0,0,10,0"/>
          <Button Content="Uninstall…" Command="{Binding UninstallCommand}" Style="{StaticResource AccentButton}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Selected.Name, FallbackValue='Select an application'}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Selected.InstallLocation}" Style="{StaticResource Muted}" FontSize="12"/>
          <TextBlock Text="{Binding Selected.BrokenReason}" Foreground="{StaticResource WarnBrush}" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" GridLinesVisibility="None"
              HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" SortMemberPath="Name"/>
        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" SortMemberPath="Publisher"/>
        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
        <DataGridTextColumn Header="Installed" Binding="{Binding InstallDateText}" Width="95" SortMemberPath="InstallDate"/>
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="85" SortMemberPath="SizeBytes"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" SortMemberPath="Status"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
