<UserControl x:Class="NeoUninstall.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Rescan" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Scheduled Tasks" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>
    <ProgressBar DockPanel.Dock="Top" Height="4" IsIndeterminate="True" Margin="0,0,0,10" Foreground="{StaticResource CyanBrush}"
                 Background="{StaticResource Surface2Brush}" BorderThickness="0" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowSystem}" Content="{Binding ShowSystemLabel}" Foreground="{StaticResource TextBrush}"
                VerticalAlignment="Center" Margin="12,0,0,0" Visibility="{Binding HasSystemFilter, Converter={StaticResource B2V}}"/>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="{Binding Selected.TaskPath}" Style="{StaticResource Muted}" FontSize="11"/>
        <TextBlock Text="{Binding Selected.Arguments}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="Evidence" Style="{StaticResource Muted}" FontSize="11"/>
        <TextBlock Text="{Binding Selected.Evidence, FallbackValue='Select a row to see the evidence.'}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" GridLinesVisibility="None"
              HeadersVisibility="Column" RowHeaderWidth="0" CanUserAddRows="False" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80"/>
        <DataGridTextColumn Header="Finding" Binding="{Binding Finding}" Width="130"/>
        <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="130"/>
        <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="130"/>
        <DataGridTextColumn Header="Executable" Binding="{Binding ExePath}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
